# Copie para .env e preencha. O arquivo .env NÃO vai para o Git (tem token e senhas).

# ---------------------------------------------------------------- AAP / AWX
# URL base, sem /api no final
AWX_URL=https://aap.empresa.com.br
# Token do usuário de serviço do portal (papel Execute só nos templates publicados)
AWX_TOKEN=
# AAP 2.5 ou mais novo: /api/controller/v2   |   AWX e AAP 2.4: /api/v2
AWX_API_PREFIX=/api/controller/v2
# false só se o AAP usar certificado autoassinado
AWX_VERIFY_SSL=true

# ---------------------------------------------------------------- Portal
# Label que publica um job template no portal
PORTAL_LABEL=portal
# Labels "grupo:<grupo do AD>" liberam o template para esse grupo
PORTAL_GROUP_PREFIX=grupo:
# Grupo do AD que vê e executa todos os templates publicados
PORTAL_ADMIN_GROUP=portal-admins
# Pergunta do survey que recebe o usuário que executou (auditoria)
PORTAL_USER_VAR=portal_user
# Chave do cookie de sessão. Gere com: openssl rand -base64 32
PORTAL_SESSION_SECRET=
PORTAL_SESSION_HOURS=8
# true quando o portal estiver atrás de HTTPS
PORTAL_COOKIE_SECURE=false
PORTAL_HISTORY_SIZE=10
PORTAL_STDOUT_MAX_KB=256

# ---------------------------------------------------------------- LDAP / Active Directory
LDAP_URL=ldaps://ad.empresa.com.br
# Conta de serviço só leitura para buscar usuários e grupos
LDAP_BIND_DN=CN=svc-portal,OU=Servicos,DC=empresa,DC=com,DC=br
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=OU=Usuarios,DC=empresa,DC=com,DC=br
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_BASE=OU=Grupos,DC=empresa,DC=com,DC=br
# AD: grupos diretos. Para grupos aninhados: (member:1.2.840.113556.1.4.1941:={user_dn})
LDAP_GROUP_FILTER=(member={user_dn})
LDAP_NAME_ATTR=displayName
# false só se o AD usar certificado de uma CA que o container não conhece
LDAP_VERIFY_TLS=true
